# ========================================================
# Student Management System - Docker Environment Variables
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
# ========================================================

# --------------------------------------------------------
# Security & Django Core Settings
# --------------------------------------------------------
# Required in production: generate a unique, cryptographically strong key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# 0 for production, 1 for local development
DEBUG=0

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Comma-separated list of origins authorized to make cross-site HTTP requests
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:8000

# --------------------------------------------------------
# Database Settings (PostgreSQL)
# --------------------------------------------------------
POSTGRES_DB=sms_db
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_super_secret_password_change_me
POSTGRES_PORT=5432
DB_HOST=db
DB_PORT=5432

# --------------------------------------------------------
# Container Port Mappings
# --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=80

# --------------------------------------------------------
# Application Initial Data
# --------------------------------------------------------
# 1 = populate database with initial courses, teachers, students, enrollments on start
# 0 = do not automatically seed demo data
SEED_DEMO=1
