# Copy to .env and fill in. Never commit the real .env.

# Required whenever DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Defaults to False. Only turn this on for local development.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API.
# Defaults to the usual local dev ports (3000, 5173, 8000, 8080).
# CORS_ALLOWED_ORIGINS=http://localhost:8080

# Set to False only if TLS is terminated upstream.
# SECURE_SSL_REDIRECT=True
