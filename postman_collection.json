{
  "info": {
    "name": "Student Management System (SMS)",
    "description": "Complete API collection for the Student Management System.\n\n## Setup\n1. Set the `base_url` variable (default: http://localhost:8000)\n2. Register a Director account\n3. Login to get access and refresh tokens\n4. Set `access_token` and `refresh_token` collection variables\n\n## Workflow\n1. Register Director -> Login as Director\n2. Create Academic Year -> Create Grade Level -> Create Section -> Create Subject\n3. Register Teacher -> Create Subject Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "teacher_access_token", "value": "" },
    { "key": "teacher_refresh_token", "value": "" },
    { "key": "student_access_token", "value": "" },
    { "key": "student_refresh_token", "value": "" },
    { "key": "director_email", "value": "director@example.com" },
    { "key": "director_password", "value": "securepassword123" },
    { "key": "teacher_email", "value": "teacher@example.com" },
    { "key": "teacher_password", "value": "securepassword123" },
    { "key": "student_email", "value": "student@example.com" },
    { "key": "student_password", "value": "securepassword123" },
    { "key": "teacher_id", "value": "" },
    { "key": "student_id", "value": "" },
    { "key": "parent_id", "value": "" },
    { "key": "academic_year_id", "value": "" },
    { "key": "grade_level_id", "value": "" },
    { "key": "section_id", "value": "" },
    { "key": "subject_id", "value": "" },
    { "key": "assignment_id", "value": "" }
  ],
