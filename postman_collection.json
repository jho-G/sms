          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{access_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/token/verify/", "host": ["{{base_url}}"], "path": ["api", "auth", "token", "verify", ""] }
          },
          "response": []
